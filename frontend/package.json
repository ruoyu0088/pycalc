{
  "name": "pycalc-editor",
  "private": true,
  "version": "0.1.0",
  "description": "CodeMirror 6 bundle embedded into pycalc.html",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --global-name=PyCalcEditor --outfile=../pycalc_build/assets/editor.bundle.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
